:root{--heading-color:#152523;--text-color:#28312a;--link-color:#1e7e5c;--highlight-color:#445d51;--deco-color:#cadcd3;--gray1:#a1a0a0;--gray2:#555;--code-bg:#e0f0ec;--bg:url("../img/bg-light.png");--serif-font-family:"Noto Serif",
  "Noto Serif SC",
  "Noto Serif TC",
  "Noto Serif CJK SC",
  "Noto Serif CJK TC",
  "Source Han Serif SC",
  "Source Han Serif TC",
  "Songti SC",
  "Times New Roman",
  Times,
  serif;--fangsong-font-family:'STFangsong',
  'FangSong',
  '仿宋',
  serif;--monospace-font-family:'Menlo',
  'Monaco',
  monospace;--heading-font:'STDongGuanTi',
  sans-serif;--text-size:18px;--code-size:16px;--len-05:0.5rem;--len-10:1rem;--len-12:1.2rem;--len-15:1.5rem;--len-20:2rem}@media(prefers-color-scheme:dark){:root{--heading-color:#beddd0;--text-color:#b0c1bb;--highlight-color:#8ba293;--deco-color:#0e1511;--gray1:#777;--gray2:#aaa;--code-bg:#2a2a2a;--bg:url("../img/bg-dark.png")}}:root[color-mode=dark]{--heading-color:#beddd0;--text-color:#b0c1bb;--highlight-color:#8ba293;--deco-color:#0e1511;--gray1:#777;--gray2:#aaa;--code-bg:#2a2a2a;--bg:url("../img/bg-dark.png")}:root[color-mode=light]{--heading-color:#152523;--text-color:#28312a;--link-color:#1e7e5c;--highlight-color:#445d51;--deco-color:#cadcd3;--gray1:#a1a0a0;--gray2:#555;--code-bg:#e0f0ec;--bg:url("../img/bg-light.png")}*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}@view-transition{navigation: auto;
}#theme-select{background:0 0;border:none;font-size:var(--len-10);color:var(--gray1)}body{font-family:var(--serif-font-family);font-size:var(--text-size);line-height:1.8;color:var(--text-color);max-width:720px;margin:0 auto;padding:0 var(--len-15);background:var(--bg)no-repeat 50% fixed}a{text-decoration:none}hr{margin:5em 3rem 3rem;border:none;height:1px;background:linear-gradient(to right,transparent,rgba(7,84,66,.6),transparent)}strong{border-bottom:2px solid var(--highlight-color)}footer{display:flex;justify-content:space-between;margin:3rem 0 var(--len-20)}footer p,footer a{color:var(--gray1);font-family:var(--fangsong-font-family);font-size:var(--len-10);letter-spacing:.5px}footer a:hover{color:var(--link-color)}@media(max-width:768px){:root{--text-size:16px;--code-size:14px}}@media(max-width:600px){body{background:var(--deco-color)}}.site-header{display:flex;justify-content:space-between;align-items:center;padding:var(--len-20)0;margin:var(--len-20)0}.site-title{font:oblique var(--len-15)var(--heading-font);color:var(--text-color)}nav{display:flex;background-color:var(--highlight-color);padding:1px 5px;border-radius:37px}nav li{padding:0 8px;justify-content:space-around;list-style-type:none}nav a{font-size:.95rem;color:var(--deco-color)}.post-list{display:flex;flex-direction:column;gap:2.5rem}.post-list h1{font-family:var(--heading-font);font-size:var(--len-15);color:var(--highlight-color);margin:var(--len-15)0 var(--len-10)}.post-list h1::before{content:"▸ "}.post-list p{font-family:var(--fangsong-font-family);text-align:center}.post-list a{color:var(--highlight-color)}.post-card a,.post-card p{color:var(--text-color)}.post-card h2{font-size:1.3rem;margin-bottom:.25rem}.post-card summary{font-family:var(--fangsong-font-family);margin-bottom:var(--len-05);color:var(--gray2)}@media(max-width:600px){.site-header{flex-direction:column;gap:var(--len-05);margin-bottom:var(--len-10);text-align:center}}.post-header{margin-bottom:var(--len-10);padding-bottom:var(--len-10)}.post-header h1{font-family:var(--heading-font);font-size:var(--len-20);color:var(--heading-color);margin:var(--len-20)0;text-align:center}.post-content{margin-bottom:10vh}.post-header create-time,.post-content lamod-time{font-size:var(--len-10);font-family:var(--monospace-font-family);color:var(--gray1)}.post-content lamod-time{margin-top:5vh;display:block;text-align:right}.post-content a,.post-header a{color:var(--link-color)}.post-content h1,.post-content h2{font-family:var(--heading-font);color:var(--heading-color)}.post-content h2{font-size:var(--len-15);margin:var(--len-20)0 var(--len-10)}.post-content h3{color:var(--highlight-color);font-family:var(--serif-font-family);font-size:var(--len-12);margin:var(--len-15)0 .75rem;text-align:center}.post-content p{margin-bottom:var(--len-12)}.post-content ul,.post-content ol{padding-left:2.5rem;margin-bottom:var(--len-12)}.post-content li{margin-bottom:.25rem}.post-content .footnotes{font-family:var(--fangsong-font-family)}.post-content del{text-decoration:none;filter:blur(5px)grayscale(80%)opacity(40%);transition:filter .2s ease}.post-content del:hover{filter:none}.post-content blockquote{margin:var(--len-05)0 var(--len-15);padding-left:var(--len-12);border-left:1px dashed var(--gray1)}.post-content blockquote p,.post-content blockquote li{color:var(--gray2);font-family:var(--fangsong-font-family)}.post-content code,.post-content pre span,.post-content pre code{font-family:var(--monospace-font-family);font-size:var(--code-size)}.post-content code{background:var(--code-bg);padding:.2em .4em;margin:.2em .4em}.post-content pre{filter:saturate(.6)brightness(1.2);padding:var(--len-10);border-radius:6px;overflow-x:auto;margin-bottom:var(--len-10)}.post-content pre code{background:0 0;padding:0}@media(max-width:768px){.post-header h1{font-size:var(--len-15)}.post-content h2{font-size:var(--len-12)}.post-content h3{font-size:var(--len-10)}.post-content blockquote{padding-left:var(--len-05)}.post-content pre{padding:var(--len-05);margin-bottom:var(--len-10)}.post-content del{text-decoration:line-through;color:var(--gray2);filter:none;transition:none}}@media(max-width:600px){.post-content .footnotes ol{padding-left:var(--len-15)}}.link-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:3em 7em;margin-top:3em}.link-card{position:relative;transition:transform .2s ease;margin:0 -1rem;filter:grayscale(60%)blur(1px)}.link-card::before{content:"";position:absolute;inset:0;background-image:linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color));background-size:3px 10px,10px 3px,3px 10px,10px 3px,3px 10px,10px 3px,3px 10px,10px 3px;background-position:0 0,0 0,100% 0,100% 0,0 100%,0 100%,100% 100%,100% 100%;background-repeat:no-repeat;opacity:.3;transition:opacity .5s ease;pointer-events:none}.link-card:hover{transform:scale(1.05);filter:contrast(150%)}.link-card:hover::before{opacity:1}.link-card a{color:var(--link-color);font-size:var(--len-10);display:block;text-align:center;margin-bottom:.35rem}.link-card p{font-size:.9rem;font-family:var(--fangsong-font-family);text-align:center;vertical-align:middle;padding:0 var(--len-15);line-height:1.5}@media(max-width:768px){.link-list{gap:var(--len-10);margin-top:var(--len-15)}}@media(max-width:1024px){.link-card,.link-card:hover{filter:none}.link-card:hover{transform:none}.link-card::before{display:none}}.fun-list{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:var(--len-10);margin-top:3em;justify-content:center}.fun-card{position:relative;justify-self:center;align-self:center}.fun-card img{display:block;justify-self:center;margin-bottom:5px;max-width:150px;height:auto}@media(max-width:600px){.fun-card img{max-width:100px}.fun-card img .fun-card .fun-intro{font-size:.6rem}}details{margin-bottom:var(--len-10)}
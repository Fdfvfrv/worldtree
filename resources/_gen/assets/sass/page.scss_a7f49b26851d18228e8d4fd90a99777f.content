:root{--heading-color:#152523;--text-color:#28312a;--link-color:#1e7e5c;--highlight-color:#445d51;--deco-color:#cadcd3;--gray1:#a1a0a0;--gray2:#555;--code-bg:#e0f0ec;--bg:url("../img/bg-light.png");--serif-font-family:serif;--fangsong-font-family:'STFangsong',
  serif;--monospace-font-family:'Menlo',
  'Monaco',
  monospace;--heading-font:'STDongGuanTi',
  sans-serif;--text-size:18px;--code-size:16px;--rem-05:0.5rem;--rem-10:1rem;--rem-12:1.2rem;--rem-15:1.5rem;--rem-20:2rem}@media(prefers-color-scheme:dark){:root{--heading-color:#beddd0;--text-color:#b0c1bb;--highlight-color:#8ba293;--deco-color:#0e1511;--gray1:#777;--gray2:#aaa;--code-bg:#2a2a2a;--bg:url("../img/bg-dark.png")}}:root[color-mode=dark]{--heading-color:#beddd0;--text-color:#b0c1bb;--highlight-color:#8ba293;--deco-color:#0e1511;--gray1:#777;--gray2:#aaa;--code-bg:#2a2a2a;--bg:url("../img/bg-dark.png")}:root[color-mode=light]{--heading-color:#152523;--text-color:#28312a;--link-color:#1e7e5c;--highlight-color:#445d51;--deco-color:#cadcd3;--gray1:#a1a0a0;--gray2:#555;--code-bg:#e0f0ec;--bg:url("../img/bg-light.png")}*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}@view-transition{navigation: auto;
}#theme-select{background:0 0;border:none;font-size:var(--rem-10);color:var(--gray1)}body{font-family:var(--serif-font-family);font-size:var(--text-size);line-height:1.8;color:var(--text-color);max-width:720px;margin:0 auto;padding:0 var(--rem-15);background:var(--bg)no-repeat 50% fixed}a{text-decoration:none}hr{margin:3em 5em;border:none;height:1px;background:linear-gradient(to right,transparent,rgba(7,84,66,.6),transparent)}strong{border-bottom:2px solid var(--highlight-color)}time{font-size:var(--rem-10);font-family:courier new,Courier,monospace;color:var(--gray1);writing-mode:sideways-lr;align-self:center;border-right:1.5px dotted var(--gray1)}footer{display:flex;justify-content:space-between;margin:3rem 0 var(--rem-20)}footer p,footer a{color:var(--gray1);font-family:var(--fangsong-font-family);font-size:var(--code-size);letter-spacing:.5px}footer a:hover{color:var(--link-color)}@media(max-width:768px){:root{--text-size:16px;--code-size:14px}}@media(max-width:600px){body{background:var(--deco-color)}time{padding-right:1px}}.site-header{display:flex;justify-content:space-between;align-items:center;padding:var(--rem-20)0;margin:var(--rem-10)0}.site-title{font:oblique var(--rem-15)var(--heading-font);color:var(--text-color)}nav{display:flex;background-color:var(--highlight-color);padding:1px 5px;border-radius:37px}nav li{padding:0 8px;justify-content:space-around;list-style-type:none}nav a{font-size:.95rem;color:var(--deco-color)}.post-list{display:flex;flex-direction:column;gap:2.5rem}.post-list h1{font-family:var(--heading-font);font-size:var(--rem-15);color:var(--highlight-color);margin:var(--rem-15)0 var(--rem-10)}.post-list h1::before{content:"▸ "}.post-card{display:grid;grid-template-columns:auto 1fr;gap:var(--rem-10);padding-left:var(--rem-05);color:inherit;justify-content:space-between}.post-card h2{font-size:1.3rem;margin-bottom:.25rem}.post-card p.sum{font-family:var(--fangsong-font-family);margin-bottom:var(--rem-05);color:var(--gray2)}.post-card a{color:var(--text-color)}@media(max-width:600px){.site-header{flex-direction:column;gap:var(--rem-10);margin-bottom:var(--rem-10);text-align:center}}.post-header{margin-bottom:var(--rem-10)}.post-header h1{font-family:var(--heading-font);font-size:var(--rem-20);color:var(--heading-color);margin:var(--rem-20)0;text-align:center}.post-content{margin-bottom:10vh}.post-content a,.post-header a{color:var(--link-color)}.post-content h1,.post-content h2{font-family:var(--heading-font);color:var(--heading-color)}.post-content h2{font-size:var(--rem-15);margin:var(--rem-20)0 var(--rem-10)}.post-content h3{color:var(--highlight-color);font-family:var(--serif-font-family);font-size:var(--rem-12);margin:var(--rem-15)0 .75rem;text-align:center}.post-content p{margin-bottom:var(--rem-12)}.post-content ul,.post-content ol{padding-left:2.5rem;margin-bottom:var(--rem-12)}.post-content li{margin-bottom:.25rem}.post-content .footnotes{font-family:var(--fangsong-font-family)}.footnote-ref::before{content:"["}.footnote-ref::after{content:"]"}.post-content del{text-decoration:none;filter:blur(5px)grayscale(80%)opacity(40%);transition:filter .2s ease}.post-content del:hover{filter:none}.post-content blockquote{margin:var(--rem-05)0 var(--rem-15);padding-left:var(--rem-12);border-left:1px dashed var(--gray1)}.post-content blockquote p,.post-content blockquote li{color:var(--gray2);font-family:var(--fangsong-font-family)}.post-content code,.post-content pre span,.post-content pre code{font-family:var(--monospace-font-family);font-size:var(--code-size)}.post-content code{background:var(--code-bg);padding:.2em .4em;margin:.2em .4em}.post-content pre{filter:saturate(.6)brightness(1.2);padding:var(--rem-10);border-radius:6px;overflow-x:auto;margin-bottom:var(--rem-10)}.post-content pre code{background:0 0;padding:0}@media(max-width:768px){.post-header h1{font-size:var(--rem-15)}.post-content h2{font-size:var(--rem-12)}.post-content h3{font-size:var(--rem-10)}.post-content blockquote{padding-left:var(--rem-05)}.post-content pre{padding:var(--rem-05);margin-bottom:var(--rem-10)}.post-content del{text-decoration:line-through;color:var(--gray2);filter:none;transition:none}}@media(max-width:600px){.post-content .footnotes ol{padding-left:var(--rem-15)}}.link-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:3em 7em;margin-top:3em}.link-card{position:relative;transition:transform .2s ease;margin:0 -1rem;filter:grayscale(60%)blur(1px)}.link-card::before{content:"";position:absolute;inset:0;background-image:linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color)),linear-gradient(var(--link-color),var(--link-color));background-size:3px 10px,10px 3px,3px 10px,10px 3px,3px 10px,10px 3px,3px 10px,10px 3px;background-position:0 0,0 0,100% 0,100% 0,0 100%,0 100%,100% 100%,100% 100%;background-repeat:no-repeat;opacity:.3;transition:opacity .5s ease;pointer-events:none}.link-card:hover{transform:scale(1.05);filter:contrast(150%)}.link-card:hover::before{opacity:1}.link-card a{color:var(--link-color);font-size:var(--rem-10);display:block;text-align:center;margin-bottom:.35rem}.link-card p{font-size:.9rem;font-family:var(--fangsong-font-family);text-align:center;vertical-align:middle;padding:0 var(--rem-15);line-height:1.5}@media(max-width:768px){.link-list{gap:var(--rem-10);margin-top:var(--rem-15)}}@media(max-width:1024px){.link-card,.link-card:hover{filter:none}.link-card:hover{transform:none}.link-card::before{display:none}}
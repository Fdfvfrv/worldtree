:root {
  --heading-color: #152523;
  --text-color: #28312a;
  --link-color: #1e7e5c;
  --highlight-color: #445d51;
  --deco-color: #cadcd3;
  --gray1: #a1a0a0;
  --gray2: #555;
  --code-bg: #e0f0ec;
  --bg: url("../img/bg-light.png");
  /* font */
  --serif-font-family:
  "Noto Serif",
  "Noto Serif SC",
  "Noto Serif TC",
  "Noto Serif CJK SC",
  "Noto Serif CJK TC",
  "Source Han Serif SC",
  "Source Han Serif TC",
  "Songti SC",
  "Times New Roman",
  Times,
  serif;
  --fangsong-font-family:
  'STFangsong',
  'FangSong',
  '仿宋',
  serif;
  --monospace-font-family:
  'Menlo',
  Consolas,
  'Courier New',
  monospace;
  --heading-font-family:
  'STDongGuanTi',
  sans-serif;
  /* size */
  --text-size: 18px;
  --code-size: 16px;
  /* length */
  --rem-05: 0.5rem;
  --rem-10: 1rem;
  --rem-12: 1.2rem;
  --rem-15: 1.5rem;
  --rem-20: 2rem;
}

@media (prefers-color-scheme: dark) {
  :root {
    --heading-color: #beddd0;
    --text-color: #b0c1bb;
    --highlight-color: #8ba293;
    --deco-color: #0e1511;
    --gray1: #777;
    --gray2: #aaa;
    --code-bg: #2a2a2a;
    --bg: url("../img/bg-dark.png");
  }
}
:root[color-mode=dark] {
  --heading-color: #beddd0;
  --text-color: #b0c1bb;
  --highlight-color: #8ba293;
  --deco-color: #0e1511;
  --gray1: #777;
  --gray2: #aaa;
  --code-bg: #2a2a2a;
  --bg: url("../img/bg-dark.png");
}

:root[color-mode=light] {
  --heading-color: #152523;
  --text-color: #28312a;
  --link-color: #1e7e5c;
  --highlight-color: #445d51;
  --deco-color: #cadcd3;
  --gray1: #a1a0a0;
  --gray2: #555;
  --code-bg: #e0f0ec;
  --bg: url("../img/bg-light.png");
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

#theme-select {
  background: none;
  border: none;
  font-size: var(--rem-10);
  color: var(--gray1);
}

body {
  font-family: var(--serif-font-family);
  font-size: var(--text-size);
  line-height: 1.8;
  color: var(--text-color);
  max-width: 720px;
  margin: 0 auto;
  padding: 0 var(--rem-15);
  background: var(--bg) no-repeat center fixed;
}

a {
  text-decoration: none;
}

hr {
  margin: 5em 3rem 3rem;
  border: none;
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(7, 84, 66, 0.6), transparent);
}

strong {
  border-bottom: 2px solid var(--highlight-color);
}

footer {
  text-align: center;
  margin: 3rem 0 var(--rem-20);
  color: var(--gray1);
  font-size: 0.85rem;
}

footer a {
  color: var(--gray1);
}

@media (max-width: 768px) {
  :root {
    --text-size: 16px;
    --code-size: 14px;
  }
}
@media (max-width: 600px) {
  body {
    background: var(--deco-color);
  }
}
/* site-header */
.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--rem-20) 0;
  border-bottom: 1px solid var(--deco-color);
  margin-bottom: var(--rem-20);
}

.site-title {
  font: bold var(--rem-15) var(--heading-font-family);
  color: var(--text-color);
}

nav a {
  margin-left: var(--rem-15);
  color: var(--text-color);
  font-size: 0.95rem;
}

/* post-list */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.post-list h1 {
  font-family: var(--heading-font-family);
  font-size: var(--rem-15);
  color: var(--highlight-color);
  margin: var(--rem-15) 0 var(--rem-10);
}

.post-list h1::before {
  content: "▸ ";
}

.post-list p {
  font-family: var(--fangsong-font-family);
  text-align: center;
}

.post-list a {
  color: var(--highlight-color);
}

.post-card a,
.post-card p {
  color: var(--text-color);
}

.post-card h2 {
  font-size: 1.3rem;
  margin-bottom: 0.25rem;
}

.post-card summary {
  font-family: var(--fangsong-font-family);
  margin-bottom: var(--rem-05);
  color: var(--gray2);
}

@media (max-width: 768px) {
  .site-header {
    flex-direction: column;
    gap: var(--rem-05);
    margin-bottom: 0;
    text-align: center;
  }
  nav a:first-child {
    margin-left: 0;
  }
}
/* post-content */
.post-header {
  margin-bottom: var(--rem-10);
  padding-bottom: var(--rem-10);
}

.post-header h1 {
  font-family: var(--heading-font-family);
  font-size: var(--rem-20);
  color: var(--heading-color);
  margin-bottom: var(--rem-05);
  text-align: center;
  margin-top: 3vh;
}

.post-content {
  margin-bottom: 10vh;
}

.post-header create-time,
.post-content lamod-time {
  font-size: 0.9rem;
  font-family: var(--monospace-font-family);
  color: var(--gray1);
}

.post-content lamod-time {
  margin-top: 5vh;
  display: block;
  text-align: right;
}

.post-content a,
.post-header a {
  color: var(--link-color);
}

.post-content h1, .post-content h2 {
  font-family: var(--heading-font-family);
  color: var(--heading-color);
}

.post-content h2 {
  font-size: var(--rem-15);
  margin: var(--rem-20) 0 var(--rem-10);
}

.post-content h3 {
  color: var(--highlight-color);
  font-family: var(--serif-font-family);
  font-size: var(--rem-12);
  margin: var(--rem-15) 0 0.75rem;
  text-align: center;
}

.post-content p {
  margin-bottom: var(--rem-12);
}

.post-content ul,
.post-content ol {
  padding-left: 2.5rem;
  margin-bottom: var(--rem-12);
}

.post-content li {
  margin-bottom: 0.25rem;
}

.post-content .footnotes {
  font-family: var(--fangsong-font-family);
}

.post-content del {
  text-decoration: none;
  filter: blur(5px) grayscale(80%) opacity(40%);
  transition: filter 0.2s ease;
}

.post-content del:hover {
  filter: none;
}

.post-content blockquote {
  color: var(--gray2);
  font-family: var(--fangsong-font-family);
  margin: var(--rem-05) 0 var(--rem-15) 0;
  padding-left: var(--rem-12);
  border-left: 1px dashed var(--gray1);
}

.post-content code, .post-content pre span, .post-content pre code {
  font-family: var(--monospace-font-family);
  font-size: var(--code-size);
}

.post-content code {
  background: var(--code-bg);
  padding: 0.2em 0.4em;
  margin: 0.2em 0.4em;
}

.post-content pre {
  filter: saturate(0.6) brightness(1.2);
  padding: var(--rem-10);
  border-radius: 6px;
  overflow-x: auto;
  margin-bottom: var(--rem-10);
}

.post-content pre code {
  background: none;
  padding: 0;
}

@media (max-width: 768px) {
  .post-header h1 {
    font-size: var(--rem-15);
  }
  .post-content h2 {
    font-size: var(--rem-12);
  }
  .post-content h3 {
    font-size: var(--rem-10);
  }
  .post-content blockquote {
    padding-left: var(--rem-05);
  }
  .post-content pre {
    padding: var(--rem-05);
    margin-bottom: var(--rem-10);
  }
  .post-content del {
    text-decoration: line-through;
    color: var(--gray2);
    filter: none;
    transition: none;
  }
}
/* links */
.link-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 3em 7em;
  margin-top: 3em;
}

.link-card {
  position: relative;
  transition: transform 0.2s ease;
  margin: 0 -1rem;
  filter: grayscale(60%) blur(1px);
}

.link-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color)), linear-gradient(var(--link-color), var(--link-color));
  background-size: 3px 10px, 10px 3px, 3px 10px, 10px 3px, 3px 10px, 10px 3px, 3px 10px, 10px 3px;
  background-position: left top, left top, right top, right top, left bottom, left bottom, right bottom, right bottom;
  background-repeat: no-repeat;
  opacity: 0.3;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.link-card:hover {
  transform: scale(1.05);
  filter: contrast(150%);
}

.link-card:hover::before {
  opacity: 1;
}

.link-card a {
  color: var(--link-color);
  font-size: var(--rem-10);
  display: block;
  text-align: center;
  margin-bottom: 0.35rem;
}

.link-card p {
  font-size: 0.9rem;
  font-family: var(--fangsong-font-family);
  text-align: center;
  vertical-align: middle;
  padding: 0 var(--rem-15);
  line-height: 1.5;
}

@media (max-width: 768px) {
  .link-list {
    gap: var(--rem-10);
    margin-top: var(--rem-15);
  }
  .link-card {
    filter: none;
  }
  .link-card:hover::before {
    display: none;
  }
}
/* books */
.book-list {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: var(--rem-10);
  margin-top: 3em;
  justify-content: center;
}

.book-card {
  position: relative;
  justify-self: center;
  align-self: center;
}

.book-card img {
  display: block;
  justify-self: center;
  margin-bottom: 5px;
  max-width: 150px;
  height: auto;
  transition: translate 0.2s, box-shadow 0.3s;
}

.book-card img:hover {
  box-shadow: 5px 5px 1px #f4f1f1;
  translate: -2px -2px;
}

@media (max-width: 768px) {
  .book-card img:hover {
    box-shadow: none;
    translate: 0;
  }
}
@media (max-width: 600px) {
  .book-card img {
    max-width: 100px;
  }
}
/* movies */
.movie-list {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: var(--rem-10);
  margin-top: 3em;
  justify-content: center;
}

.movie-card {
  position: relative;
  justify-self: center;
  align-self: center;
}

.movie-card img {
  display: block;
  justify-self: center;
  margin-bottom: 5px;
  max-width: 150px;
  height: auto;
  transition: translate 0.2s, box-shadow 0.3s;
}

@media (max-width: 768px) {
  .movie-card:hover {
    display: none;
  }
}
@media (max-width: 600px) {
  .book-card:hover {
    display: none;
  }
  .movie-card .movie-intro {
    font-size: 0.6rem;
  }
}

/*# sourceMappingURL=page.css.map */